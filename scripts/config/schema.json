{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH plugin repository local configuration",
  "description": "Generated by config init. Relative paths are based on the repository root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tools",
    "web",
    "test",
    "targets",
    "legacy"
  ],
  "properties": {
    "$schema": {
      "const": "./schema.json",
      "description": "Optional editor schema reference; the reader always uses the repository schema."
    },
    "version": {
      "const": 2
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pnpmScript"
      ],
      "properties": {
        "pnpmScript": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S",
          "description": "Path to pnpm.cjs; optional for Web startup."
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser",
        "browserPath",
        "openBrowser",
        "startupTimeoutMs"
      ],
      "properties": {
        "browser": {
          "enum": [
            "edge",
            "default"
          ]
        },
        "browserPath": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S",
          "description": "Edge executable. Ignored when browser is default or openBrowser is false."
        },
        "openBrowser": {
          "type": "boolean"
        },
        "startupTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser",
        "browserPath",
        "timeoutMs"
      ],
      "properties": {
        "browser": {
          "enum": [
            "chrome",
            "chromium"
          ]
        },
        "browserPath": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S",
          "description": "Chrome executable. Ignored for Playwright-managed chromium."
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Timeout per DSH harness operation and browser scenario, in milliseconds."
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "dshCli",
          "home",
          "profile",
          "surface",
          "platform"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "dshCli": {
            "type": "string",
            "pattern": "\\S"
          },
          "home": {
            "type": "string",
            "pattern": "\\S"
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "surface": {
            "enum": [
              "desktop",
              "web"
            ]
          },
          "platform": {
            "enum": [
              "windows",
              "mac"
            ]
          }
        }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dshCli"
      ],
      "properties": {
        "dshCli": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S",
          "description": "Unverified v1 information only; never an active target."
        }
      }
    }
  }
}
