{
  "name": "@mbda9091/web-hello",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal Web fixture plugin for the DSH Web L5 harness",
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "completion.js",
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "targets": {
      "surfaces": ["web"],
      "platforms": ["windows", "mac", "linux"]
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
