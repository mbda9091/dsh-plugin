{
  "name": "@local/web-hello",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal Web fixture plugin for the DSH Web L5 harness",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "targets": {
      "surfaces": ["web"],
      "platforms": ["windows", "mac"]
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
