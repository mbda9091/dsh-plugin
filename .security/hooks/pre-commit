#!/bin/sh
set -eu
repo_root=$(git rev-parse --show-toplevel)
git_dir=$(git rev-parse --absolute-git-dir)
if [ -e "$git_dir/repo-security-setup.lock" ] || [ -L "$git_dir/repo-security-setup.lock" ]; then
    echo 'Security setup is running or interrupted; finish setup before committing.' >&2
    exit 2
fi
exec "$repo_root/.security/run" staged --require-ready
