# Copy to .env (git-ignored). Never put actual keys in this example.
DEEPSEEK_API_KEY=
# Separate key for the local Hindsight API; also export it to the DSH process.
ROLE_HINDSIGHT_API_KEY=
# Use a random hexadecimal password: it is embedded in a PostgreSQL URL.
HINDSIGHT_DB_PASSWORD=
HINDSIGHT_LLM_MODEL=deepseek-flash
HINDSIGHT_API_PORT=8888
HINDSIGHT_UI_PORT=9999
