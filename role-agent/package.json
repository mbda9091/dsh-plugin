{
  "name": "@mbda9091/role-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scoped growing role agent with sourced Hindsight memory and revisioned learning",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./preset": {
      "types": "./lib/preset.d.ts",
      "default": "./preset.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "cordis.patch.yml",
    "profile.defaults.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "THIRD_PARTY_NOTICES",
    "preset.js",
    "deploy/hindsight/compose.yaml",
    "deploy/hindsight/compose.host-network.yaml",
    "deploy/hindsight/download-models.py",
    "deploy/hindsight/env.example",
    "deploy/hindsight/README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "zod": "4.4.3",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-jobs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-schedule": "0.2.2-rc.1"
  },
  "dshPlugin": {
    "profileDefaults": "./profile.defaults.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "targets": {
      "surfaces": [
        "desktop",
        "web"
      ],
      "platforms": [
        "linux",
        "mac",
        "windows"
      ]
    }
  }
}
